  },
  {
   "cell_type": "code",
   "execution_count": 60,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(torch.Size([182580, 5]), torch.Size([182580]))"
      ]
     },
     "execution_count": 60,
